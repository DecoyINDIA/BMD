<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/quick_download_glass"
    android:paddingHorizontal="6dp">

    <LinearLayout
        android:id="@+id/quick_download_form"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/quick_download_url"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/quick_download_widget_control"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="8dp"
            android:singleLine="true"
            android:text="@string/quick_download_url"
            android:textColor="#D7E4F4"
            android:textSize="14sp" />
        <TextView
            android:id="@+id/quick_download_button"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/quick_download_widget_control"
            android:gravity="center"
            android:paddingHorizontal="14dp"
            android:text="@string/quick_download_action"
            android:textColor="#E4FFFA"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/quick_download_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:layout_marginHorizontal="18dp"
        android:indeterminateTint="#9CEBDD"
        android:progressBackgroundTint="#57728D"
        android:progressTint="#9CEBDD"
        android:visibility="gone" />

    <TextView
        android:id="@+id/quick_download_success"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:accessibilityLiveRegion="polite"
        android:gravity="center"
        android:paddingHorizontal="12dp"
        android:text="@string/quick_download_success"
        android:textColor="#E4FFFA"
        android:textSize="15sp"
        android:textStyle="bold"
        android:visibility="gone" />
</FrameLayout>
